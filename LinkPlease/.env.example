# Pseudogram Mock API Configuration
PSEUDOGRAM_API_BASE_URL=https://pseudogram-api.onrender.com
PSEUDOGRAM_API_KEY=your_pseudogram_api_key_here

# Database Configuration
# SQLite (default for local deployment): sqlite+aiosqlite:///./linkplease.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/linkplease
DATABASE_URL=sqlite+aiosqlite:///./linkplease.db

# Webhook Security
WEBHOOK_SIGNATURE_REQUIRED=false

# Worker & Retry Settings
MAX_DM_ATTEMPTS=5
LOG_LEVEL=INFO
